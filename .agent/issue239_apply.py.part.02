l();
        };
        Self::wrap(CoreOwnedShipRow {
            ship_id,
            ship_type_id: u32::try_from(ship_type_id).ok(),
            ship_type_name: (!ship_type_name.is_empty()).then(|| ship_type_name.to_string()),
            docked_station_id: u32::try_from(docked_station_id).ok(),
            is_active,
        })
        .to_variant()
    }
}
'''
