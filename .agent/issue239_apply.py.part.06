_apply_initial_state(11)
\tvar loadout := PlayerLoadout.new()
\tvar module := ModuleRow.test_fixture(
\t\t"High", 0, 1, "Gun", "Weapon", true, true, 20.0, 10
\t) as ModuleRow
\tassert_bool(loadout.test_fixture(0, [module], -1, "", -1, [])).is_true()
\t_session.advance_client_ticks(1, loadout)
\tvar modules: Array = loadout.modules()
\tassert_int(_session.current_tick()).is_equal(1)
\tassert_float(_session.capacitor_status().current).is_equal_approx(20.0, 0.001)
\tassert_int((modules[0] as ModuleRow).cycle_remaining).is_equal(10)
''',
    "migrate world session loadout fixture",
)
