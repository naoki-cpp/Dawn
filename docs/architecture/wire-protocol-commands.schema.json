{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientCommandJson",
  "description": "Every message a client can send to the server over the WebSocket connection. Serialized as a single JSON line tagged by `\"type\"`.\n\nThis enum is the schema-of-record for the client -> server half of the wire protocol (see [`EventJson`] for the server -> client half). It intentionally mirrors the wire format exactly, including the two backward-compatible quirks below -- it does not enforce the \"exactly one of these two fields\" business rules those quirks involve; that validation still happens in [`parse_client_command`], same as before this enum existed.\n\n- `WarpCommand` accepts either `target` (current) or `gate_id` (legacy); `target` wins if both are present. - `ApproachCommand` / `OrbitCommand` / `KeepAtRangeCommand` select their target with either `gate_id` (a Jump Gate) or `target_id` (a Ship); `gate_id` wins if both are present.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "ship_id",
        "target",
        "type"
      ],
      "properties": {
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "target": {
          "$ref": "#/definitions/PosJson"
        },
        "type": {
          "type": "string",
          "enum": [
            "MoveCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "ship_id",
        "target_id",
        "type"
      ],
      "properties": {
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "target_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "LockOnCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "module_id",
        "ship_id",
        "slot",
        "type"
      ],
      "properties": {
        "module_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "slot": {
          "type": "string"
        },
        "target_ship_id": {
          "description": "Target of a targeted module (Weapon/Tackle), per ADR-0035. Required only for targeted module kinds; validated server-side.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "ActivateModuleCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "module_id",
