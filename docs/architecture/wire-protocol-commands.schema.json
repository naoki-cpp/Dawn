{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientRequestEnvelope",
  "description": "Versioned payload carried by the new Sector-command wire variant.\n\nKeeping this framing separate from [`ClientRequest`] lets the request enum\nremain the single intent catalog while giving postcard a hard compatibility\nboundary. The legacy command occupied outer enum index 1; that index remains\nreserved in the private wire enum below.",
  "type": "object",
  "properties": {
    "protocol_magic": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "protocol_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "request": {
      "$ref": "#/$defs/ClientRequest"
    }
  },
  "required": [
    "protocol_magic",
    "protocol_version",
    "request"
  ],
  "$defs": {
    "ApproachTarget": {
      "description": "What an approaching Ship is steering toward (ADR-0015).\n\nA `Ship` target is dynamic (its position is read from the ECS each tick);\na `Gate` target is a static Jump Gate position, letting players fly back\ninto a gate's `activation_radius` to jump.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Ship": {
              "$ref": "#/$defs/ShipId"
            }
          },
          "additionalProperties": false,
          "required": [
            "Ship"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Gate": {
              "$ref": "#/$defs/JumpGateId"
            }
          },
          "additionalProperties": false,
          "required": [
            "Gate"
          ]
        }
      ]
    },
    "CelestialBodyId": {
      "description": "Identifies a star, planet, or other celestial body within a Sector (ADR-0025).\nValues are globally unique across all Sectors.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ClientRequest": {
      "description": "The single authoritative catalog of requests an external Sector client may send.\n\nThis serialization-ready enum is shared by the client encoder, WebSocket decoder,\nand the application admission seam. Family-local command structs above remain\ninternal policy inputs; there is no second mirrored full request enum. Acting\nidentities for active-ship operations are intentionally absent and are supplied\nby the admitted server session.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Stop",
            "Undock",
            "Disembark"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Move": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/Position"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Move"
          ]
        },
        {
          "type": "object",
          "properties": {
            "LockOn": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/ShipId"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "LockOn"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ActivateModule": {
              "type": "object",
              "properties": {
                "module": {
                  "$ref": "#/$defs/ModuleId"
                },
                "slot": {
                  "$ref": "#/$defs/SlotKind"
                },
                "target": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ShipId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "module",
                "slot"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ActivateModule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "DeactivateModule": {
              "type": "object",
              "properties": {
                "module": {
                  "$ref": "#/$defs/ModuleId"
                },
                "slot": {
                  "$ref": "#/$defs/SlotKind"
                }
              },
              "required": [
                "module",
                "slot"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "DeactivateModule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Attack": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/ShipId"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Attack"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Jump": {
              "type": "object",
              "properties": {
                "gate": {
                  "$ref": "#/$defs/JumpGateId"
                }
              },
              "required": [
                "gate"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Jump"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Approach": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/ApproachTarget"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Approach"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Warp": {
              "type": "object",
              "properties": {
                "target": {
                  "$ref": "#/$defs/WarpTarget"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Warp"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Orbit": {
              "type": "object",
              "properties": {
                "radius": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                },
                "target": {
                  "$ref": "#/$defs/ApproachTarget"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Orbit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "KeepAtRange": {
              "type": "object",
              "properties": {
                "range": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                },
                "target": {
                  "$ref": "#/$defs/ApproachTarget"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "KeepAtRange"
          ]
        },
        {
          "type": "object",
          "properties": {
            "FitModule": {
              "type": "object",
              "properties": {
                "module": {
                  "$ref": "#/$defs/ModuleId"
                },
                "ship": {
                  "$ref": "#/$defs/ShipId"
                },
                "slot": {
                  "$ref": "#/$defs/SlotKind"
                }
              },
              "required": [
                "ship",
                "module",
                "slot"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "FitModule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "UnfitModule": {
              "type": "object",
              "properties": {
                "module": {
                  "$ref": "#/$defs/ModuleId"
                },
                "ship": {
                  "$ref": "#/$defs/ShipId"
                },
                "slot": {
                  "$ref": "#/$defs/SlotKind"
                }
              },
              "required": [
                "ship",
                "module",
                "slot"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "UnfitModule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ReorderFittedModule": {
              "type": "object",
              "properties": {
                "from_index": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "ship": {
                  "$ref": "#/$defs/ShipId"
                },
                "slot": {
                  "$ref": "#/$defs/SlotKind"
                },
                "to_index": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "required": [
                "ship",
                "slot",
                "from_index",
                "to_index"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ReorderFittedModule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Dock": {
              "type": "object",
              "properties": {
                "station": {
                  "$ref": "#/$defs/StationId"
                }
              },
              "required": [
                "station"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Dock"
          ]
        },
        {
          "type": "object",
          "properties": {
            "BuildPackagedShip": {
              "type": "object",
              "properties": {
                "ship": {
                  "$ref": "#/$defs/ShipId"
                },
                "ship_type": {
                  "$ref": "#/$defs/ShipTypeId"
                },
                "station": {
                  "$ref": "#/$defs/StationId"
                }
              },
              "required": [
                "ship",
                "station",
                "ship_type"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "BuildPackagedShip"
          ]
        },
        {
          "type": "object",
          "properties": {
            "DisassembleShip": {
              "type": "object",
              "properties": {
                "ship": {
                  "$ref": "#/$defs/ShipId"
                },
                "station": {
                  "$ref": "#/$defs/StationId"
                }
              },
              "required": [
                "ship",
                "station"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "DisassembleShip"
          ]
        },
        {
          "type": "object",
          "properties": {
            "SelectActiveShip": {
              "type": "object",
              "properties": {
                "ship": {
                  "$ref": "#/$defs/ShipId"
                }
              },
              "required": [
                "ship"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "SelectActiveShip"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Assemble": {
              "type": "object",
              "properties": {
                "ship_type": {
                  "$ref": "#/$defs/ShipTypeId"
                },
                "station": {
                  "$ref": "#/$defs/StationId"
                }
              },
              "required": [
                "station",
                "ship_type"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "Assemble"
          ]
        },
        {
          "type": "object",
          "properties": {
            "TransferCargo": {
              "type": "object",
              "properties": {
                "direction": {
                  "$ref": "#/$defs/TransferDirection"
                },
                "item": {
                  "$ref": "#/$defs/ItemId"
                },
                "ship": {
                  "$ref": "#/$defs/ShipId"
                },
                "station": {
                  "$ref": "#/$defs/StationId"
                }
              },
              "required": [
                "ship",
                "station",
                "item",
                "direction"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "TransferCargo"
          ]
        }
      ]
    },
    "EntityId": {
      "description": "Globally unique, non-reusable identifier for any entity in the world.\n\nLayout: `[node_id: 8 bits | counter: 56 bits]`\n\n`Ord` is the canonical id order: because `node_id` occupies the high bits,\ncomparing the packed `u64` orders by `node_id` first, then `counter`. Use it\nfor any determinism need (e.g. byte-stable snapshots, INV-002).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "ItemId": {
      "description": "Canonical identity for every inventory and Market item (ADR-0034).\n\nThe variant owns the only identifier that is valid for that item kind, so\nimpossible combinations such as a Module carrying a ShipTypeId cannot be\nrepresented in domain code.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ScrapMetal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Module": {
              "$ref": "#/$defs/ModuleId"
            }
          },
          "additionalProperties": false,
          "required": [
            "Module"
          ]
        },
        {
          "type": "object",
          "properties": {
            "PackagedShip": {
              "$ref": "#/$defs/ShipTypeId"
            }
          },
          "additionalProperties": false,
          "required": [
            "PackagedShip"
          ]
        }
      ]
    },
    "JumpGateId": {
      "description": "Identifies a Jump Gate (a fixed navigation point within a Sector).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ModuleId": {
      "description": "ID identifying a module's kind.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "Position": {
      "description": "3-D coordinates of an entity in its current simulation frame.\n\nComponents are `f64` so anchor-relative motion does not reintroduce the\nprecision loss that absolute coordinates were moved to `AbsolutePosition`\nto avoid (ADR-0044).",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "ShipId": {
      "description": "Typed wrapper that distinguishes a Ship entity from any future entity type.",
      "$ref": "#/$defs/EntityId"
    },
    "ShipTypeId": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "SlotKind": {
      "description": "The kind of an equipment slot.",
      "type": "string",
      "enum": [
        "High",
        "Mid",
        "Low",
        "Rig"
      ]
    },
    "StationId": {
      "description": "Identifies an NPC-provided station within a Sector (ADR-0034 9B foundation).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "TransferDirection": {
      "description": "Which way `TransferToStationCommand` moves the stack.",
      "oneOf": [
        {
          "description": "Ship cargo -> station inventory (the original, one-way behavior).",
          "type": "string",
          "const": "ToStation"
        },
        {
          "description": "Station inventory -> ship cargo.",
          "type": "string",
          "const": "ToShip"
        }
      ]
    },
    "WarpTarget": {
      "description": "The destination of a `WarpCommand` (ADR-0025).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "Gate": {
              "$ref": "#/$defs/JumpGateId"
            }
          },
          "additionalProperties": false,
          "required": [
            "Gate"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Body": {
              "$ref": "#/$defs/CelestialBodyId"
            }
          },
          "additionalProperties": false,
          "required": [
            "Body"
          ]
        }
      ]
    }
  }
}
