  "definitions": {
    "PosJson": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "z": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "WarpTargetJson": {
      "description": "A `{\"Gate\": N}` or `{\"Body\": N}` warp destination, as sent by `WarpCommand`'s current wire format (externally tagged: the variant name is the JSON object's only key).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Gate"
          ],
          "properties": {
            "Gate": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Body"
          ],
          "properties": {
            "Body": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
