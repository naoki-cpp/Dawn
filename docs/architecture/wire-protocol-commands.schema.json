{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientCommandJson",
  "description": "Every message a client can send to the server over the WebSocket connection. Serialized as a single JSON line tagged by `\"type\"`.\n\nThis enum is the schema-of-record for the client -> server half of the wire protocol (see [`super::EventJson`] for the server -> client half). It intentionally mirrors the wire format exactly, including the two backward-compatible quirks below -- it does not enforce the \"exactly one of these two fields\" business rules those quirks involve; that validation still happens in [`parse_client_command`], same as before this enum existed.\n\n- `WarpCommand` accepts either `target` (current) or `gate_id` (legacy); `target` wins if both are present. - `ApproachCommand` / `OrbitCommand` / `KeepAtRangeCommand` select their target with either `gate_id` (a Jump Gate) or `target_id` (a Ship); `gate_id` wins if both are present.\n\nFlight/steering/module/Undock variants carry no `ship_id` (ADR-0037): the server always resolves them against the caller's active ship, so there is no wire-representable way to name a ship the player isn't currently flying. Station inventory-management variants (Fit/Unfit/Dock/ BuildPackagedShip/DisassembleShip) still carry an explicit `ship_id`, since they may target any owned docked ship, not just the active one.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "target",
        "type"
      ],
      "properties": {
        "target": {
          "$ref": "#/definitions/PosJson"
        },
        "type": {
          "type": "string",
          "enum": [
            "MoveCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "target_id",
        "type"
      ],
      "properties": {
        "target_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "LockOnCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "module_id",
        "slot",
        "type"
      ],
      "properties": {
        "module_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "slot": {
          "type": "string"
        },
        "target_ship_id": {
          "description": "Target of a targeted module (Weapon/Tackle), per ADR-0035. Required only for targeted module kinds; validated server-side.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "ActivateModuleCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "module_id",
        "slot",
        "type"
      ],
      "properties": {
        "module_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "slot": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "DeactivateModuleCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "attacker_id",
        "target_id",
        "type"
      ],
      "properties": {
        "attacker_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "target_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "AttackCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "StopCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "gate_id",
        "type"
      ],
      "properties": {
        "gate_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "JumpCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "gate_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "target_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "ApproachCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "gate_id": {
          "description": "Legacy form: `{\"gate_id\": N}` instead of `{\"target\": {\"Gate\": N}}`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/definitions/WarpTargetJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "WarpCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "gate_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "radius": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "target_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "OrbitCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "gate_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "range": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "target_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "KeepAtRangeCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "module_id",
        "ship_id",
        "slot",
        "type"
      ],
      "properties": {
        "module_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "slot": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "FitModuleCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "module_id",
        "ship_id",
        "slot",
        "type"
      ],
      "properties": {
        "module_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "slot": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "UnfitModuleCommand"
          ]
        }
      }
    },
    {
      "description": "Reorder two fitted modules within the same slot kind (drag-and-drop reorder in the FITTED column).",
      "type": "object",
      "required": [
        "from_index",
        "ship_id",
        "slot",
        "to_index",
        "type"
      ],
      "properties": {
        "from_index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "slot": {
          "type": "string"
        },
        "to_index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "ReorderFittedModuleCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "station_id",
        "type"
      ],
      "properties": {
        "station_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "DockCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "UndockCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "ship_id",
        "ship_type_id",
        "station_id",
        "type"
      ],
      "properties": {
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "ship_type_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "station_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "BuildPackagedShipCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "ship_id",
        "station_id",
        "type"
      ],
      "properties": {
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "station_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "DisassembleShipCommand"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "ship_id",
        "type"
      ],
      "properties": {
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "SelectActiveShipCommand"
          ]
        }
      }
    },
    {
      "description": "Convert a station-inventory Packaged Ship item into a new live docked ship (ADR-0034 9B, ADR-0037). No `ship_id` -- the ship doesn't exist yet; its ID is reported via the resulting `ShipAssembled` event.",
      "type": "object",
      "required": [
        "ship_type_id",
        "station_id",
        "type"
      ],
      "properties": {
        "ship_type_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "station_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "AssembleCommand"
          ]
        }
      }
    },
    {
      "description": "Clear the caller's active ship while docked, without disassembling it (ADR-0037). No `ship_id` -- always targets the caller's own active ship, like `UndockCommand`.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DisembarkCommand"
          ]
        }
      }
    },
    {
      "description": "Move the entire stack of an item between a docked ship's own cargo and the caller's station inventory (ADR-0034 9B), in the direction `direction` says (`\"ToStation\"` or `\"ToShip\"`). `item_type` is one of `\"Module\"`, `\"PackagedShip\"`, `\"ScrapMetal\"` (matching `ItemRow`'s wire shape) with `module_id`/`ship_type_id` populated only for the variant that uses them (`0` otherwise).",
      "type": "object",
      "required": [
        "direction",
        "item_type",
        "module_id",
        "ship_id",
        "ship_type_id",
        "station_id",
        "type"
      ],
      "properties": {
        "direction": {
          "type": "string"
        },
        "item_type": {
          "type": "string"
        },
        "module_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "ship_type_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "station_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "type": {
          "type": "string",
          "enum": [
            "TransferToStationCommand"
          ]
        }
      }
    }
  ],
  "definitions": {
    "PosJson": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "z": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "WarpTargetJson": {
      "description": "A `{\"Gate\": N}` or `{\"Body\": N}` warp destination, as sent by `WarpCommand`'s current wire format (externally tagged: the variant name is the JSON object's only key).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Gate"
          ],
          "properties": {
            "Gate": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Body"
          ],
          "properties": {
            "Body": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
