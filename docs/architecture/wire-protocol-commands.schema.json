          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "ship_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "slot": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "DeactivateModuleCommand"
          ]
        }
