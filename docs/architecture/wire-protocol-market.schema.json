{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarketCommandWire",
  "description": "A client request handled by the Market authority, outside the Sector command stream (ADR-0034).",
  "oneOf": [
    {
      "description": "Request the caller's Currency balance and currently open orders.",
      "type": "object",
      "required": [
        "RefreshMarketCommand"
      ],
      "properties": {
        "RefreshMarketCommand": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Place a limit Bid or Ask for one item stack.",
      "type": "object",
      "required": [
        "PlaceMarketOrderCommand"
      ],
      "properties": {
        "PlaceMarketOrderCommand": {
          "type": "object",
          "required": [
            "item_type",
            "module_id",
            "price",
            "quantity",
            "ship_id",
            "ship_type_id",
            "side"
          ],
          "properties": {
            "item_type": {
              "type": "string"
            },
            "module_id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "price": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "quantity": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "ship_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "ship_type_id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "side": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Cancel one of the caller's own open orders.",
      "type": "object",
      "required": [
        "CancelMarketOrderCommand"
      ],
      "properties": {
        "CancelMarketOrderCommand": {
          "type": "object",
          "required": [
            "order_id"
          ],
          "properties": {
            "order_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
