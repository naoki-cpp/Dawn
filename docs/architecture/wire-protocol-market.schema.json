{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketCommandWire",
  "description": "A client request handled by the Market authority, outside the Sector\ncommand stream (ADR-0034).",
  "oneOf": [
    {
      "description": "Request the caller's Currency balance and currently open orders.",
      "type": "object",
      "properties": {
        "RefreshMarketCommand": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "RefreshMarketCommand"
      ]
    },
    {
      "description": "Place a limit Bid or Ask for one item stack.",
      "type": "object",
      "properties": {
        "PlaceMarketOrderCommand": {
          "type": "object",
          "properties": {
            "item_type": {
              "type": "string"
            },
            "module_id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "price": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "quantity": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "ship_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "ship_type_id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "side": {
              "type": "string"
            }
          },
          "required": [
            "ship_id",
            "item_type",
            "module_id",
            "ship_type_id",
            "side",
            "price",
            "quantity"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "PlaceMarketOrderCommand"
      ]
    },
    {
      "description": "Cancel one of the caller's own open orders.",
      "type": "object",
      "properties": {
        "CancelMarketOrderCommand": {
          "type": "object",
          "properties": {
            "order_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "order_id"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "CancelMarketOrderCommand"
      ]
    }
  ]
}
