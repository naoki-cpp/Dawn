            "tick": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "velocity": {
              "$ref": "#/$defs/VelWire"
            }
          },
          "required": [
            "ship_id",
            "velocity",
            "tick"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "VelocityChanged"
