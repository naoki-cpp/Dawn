  "$defs": {
    "AbsPosWire": {
      "description": "Absolute (Sector-frame, f64) position (ADR-0029). Distinct from\n[`dawn_core::Position`] (f64), which carries client-authored command targets\nrather than server-authoritative absolute coordinates.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "ServerFactDeactivationReason": {
      "description": "Protocol-owned reason for a system-forced module deactivation.",
      "type": "string",
      "enum": [
        "CapacitorExhausted",
        "OutOfRange"
      ]
    },
    "ServerFactRepairLayer": {
      "description": "Protocol-owned repair-layer identity.",
      "type": "string",
      "enum": [
        "Shield",
        "Armor"
      ]
    },
    "ServerFactSlot": {
      "description": "Protocol-owned slot identity. The client-facing schema must not expose a\ndebug-formatted domain enum or an arbitrary string.",
      "type": "string",
      "enum": [
        "High",
        "Mid",
        "Low",
        "Rig"
      ]
    },
    "VelWire": {
      "description": "Velocity components carried by server-authoritative wire messages.",
      "type": "object",
      "properties": {
        "dx": {
          "type": "number",
          "format": "double"
        },
        "dy": {
          "type": "number",
          "format": "double"
        },
        "dz": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "dx",
        "dy",
        "dz"
      ]
    }
  }
}
