  "definitions": {
    "AbsPosWire": {
      "description": "Absolute (Sector-frame, f64) position (ADR-0029). Distinct from [`crate::PosWire`] (f64), which carries client-authored command targets rather than server-authoritative absolute coordinates.",
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "VelWire": {
