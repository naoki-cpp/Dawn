# ── Rust / Cargo ─────────────────────────────────────────────────────────────
/target/
**/.DS_Store
__pycache__/

# ── Godot 4 ──────────────────────────────────────────────────────────────────
client/.godot/
client/android/
client/ios/
client/export/
*.uid

# Godot export templates（大容量・再ダウンロード可能）
client/.godot/export_credentials

# ── godot-rust / GDExtension ──────────────────────────────────────────────────
client/gdextension/target/

# Editor addons are restored per-machine by the shared Godot preparer,
# not vendored (e.g. GdUnit4). The runtime
# lens effect is the explicitly vendored exception.
client/addons/*
!client/addons/lens_effects/

# Godot engine binary, downloaded per-machine by scripts/setup-godot.(sh|ps1)
# and pinned by .godot-version (uv/pyenv-style local toolchain, not vendored).
/.tools/
/.tmp/

# gdUnit4 test run reports (XML/HTML), regenerated on every test run.
client/reports/
client/.godot-test-logs/
client/server_url.txt

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
.claude/settings.local.json

# ── OS ───────────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ── 環境変数 / シークレット ───────────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# ── Playtest session logs (generated at runtime) ──────────────────────────────
data/session_*.json
*.sqlite
