[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]
windows.debug.x86_64   = "res://../target/debug/dawn_client_gdext.dll"
windows.release.x86_64 = "res://../target/release/dawn_client_gdext.dll"
linux.debug.x86_64      = "res://../target/debug/libdawn_client_gdext.so"
linux.release.x86_64    = "res://../target/release/libdawn_client_gdext.so"
macos.debug             = "res://../target/debug/libdawn_client_gdext.dylib"
macos.release           = "res://../target/release/libdawn_client_gdext.dylib"
